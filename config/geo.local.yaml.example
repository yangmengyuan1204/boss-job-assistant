# ============================================================
# geo.local.yaml.example · P5 地理编码本地配置示例
# ============================================================
# 使用方法：
#   cp config/geo.local.yaml.example config/geo.local.yaml
#   然后在 geo.local.yaml 中填入真实 API Key
#
# 注意：geo.local.yaml 已在 .gitignore 中，不会被提交。
#       不要把真实 Key 写入本 .example 文件（本文件已入 Git）。
# ============================================================

# 高德地图 Web Service API Key
# 申请地址：https://lbs.amap.com/dev/
# 读取优先级：环境变量 AMAP_API_KEY > .env > 本文件
amap_api_key: ""
